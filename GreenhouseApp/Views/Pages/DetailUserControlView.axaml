<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GreenhouseApp.ViewModels.Pages"
             xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:DetailUserControlViewModel"
             x:Class="GreenhouseApp.Views.Pages.DetailUserControlView">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">

    <!-- HEADER -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <Grid ColumnDefinitions="Auto, Auto">
        <Image Grid.Column="0"
               Width="128" Height="128"
               Source="/Assets/arctic-2035.png"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="SMART GREENHOUSE"
                   Foreground="White" FontSize="26" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>

    <!-- ПОЧВА + КЛИМАТ -->
    <Grid Grid.Row="1" ColumnDefinitions="460,*" Margin="0,0,0,12">

      <!-- ДАТЧИКИ ПОЧВЫ -->
      <Border Grid.Column="0" Classes="card" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="ДАТЧИКИ ПОЧВЫ" Classes="label"/>

          <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
            <StackPanel Grid.Column="0">
              <TextBlock Text="ДАТЧИК 1" Foreground="#7FB3D5" FontSize="10"/>
              <TextBlock FontSize="32" FontWeight="Bold" Foreground="White">
                <Run Text="{Binding Sensor1Moisture, StringFormat={}{0:F1}}"/>
                <Run Text="%"/>
              </TextBlock>
              <TextBlock Text="{Binding Sensor1Raw, StringFormat='RAW: {0}'}"
                         Foreground="#888" FontSize="10"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
              <TextBlock Text="ДАТЧИК 2" Foreground="#7FB3D5" FontSize="10"/>
              <TextBlock FontSize="32" FontWeight="Bold" Foreground="White">
                <Run Text="{Binding Sensor2Moisture, StringFormat={}{0:F1}}"/>
                <Run Text="%"/>
              </TextBlock>
              <TextBlock Text="{Binding Sensor2Raw, StringFormat='RAW: {0}'}"
                         Foreground="#888" FontSize="10"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ДВА DHT -->
      <Border Grid.Column="1" Classes="card">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="ДАТЧИК 1 · ТЕМП." Classes="label"/>
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0">
              <Run Text="{Binding Temperature1, StringFormat={}{0:F1}}"/>
              <Run Text="°C"/>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock Text="ДАТЧИК 1 · ВЛАЖН." Classes="label"/>
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0">
              <Run Text="{Binding Humidity1, StringFormat={}{0:F0}}"/>
              <Run Text="%"/>
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
            <TextBlock Text="ДАТЧИК 2 · ТЕМП." Classes="label"/>
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0">
              <Run Text="{Binding Temperature2, StringFormat={}{0:F1}}"/>
              <Run Text="°C"/>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
            <TextBlock Text="ДАТЧИК 2 · ВЛАЖН." Classes="label"/>
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0">
              <Run Text="{Binding Humidity2, StringFormat={}{0:F0}}"/>
              <Run Text="%"/>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- УПРАВЛЕНИЕ -->
    <Border Grid.Row="2" Classes="card" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="УПРАВЛЕНИЕ" Classes="label" Margin="0,0,0,10"/>
        <WrapPanel>
          <Button Classes="cmd" Content="Полив ВКЛ"   Command="{Binding PumpOnCommand}"/>
          <Button Classes="cmd" Content="Полив ВЫКЛ"  Command="{Binding PumpOffCommand}"/>
          <Button Classes="cmd" Content="Крыша ОТКР"  Command="{Binding RoofOpenCommand}"/>
          <Button Classes="cmd" Content="Крыша ЗАКР"  Command="{Binding RoofCloseCommand}"/>
          <Button Classes="cmd" Content="Свет ВКЛ"    Command="{Binding LightOnCommand}"/>
          <Button Classes="cmd" Content="Свет ВЫКЛ"   Command="{Binding LightOffCommand}"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- ГРАФИК -->
    <Border Grid.Row="3" Classes="card" Margin="0,0,0,12">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{Binding ChartTitle}" Classes="label"
                     VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                      VerticalAlignment="Center" HorizontalAlignment="Left">
            <Button Classes="tab" Command="{Binding ShowSoilChartCommand}"
                    ToolTip.Tip="Влажность почвы">
              <StackPanel Orientation="Vertical" Spacing="3">
                <TextBlock Text="Почва" Foreground="White" FontSize="12"/>
                <Border Height="2" CornerRadius="1" Background="#4FC3F7"
                        IsVisible="{Binding IsSoilChart}"/>
              </StackPanel>
            </Button>
            <Button Classes="tab" Command="{Binding ShowTemperatureChartCommand}"
                    ToolTip.Tip="Температура DHT">
              <StackPanel Orientation="Vertical" Spacing="3">
                <TextBlock Text="Температура" Foreground="White" FontSize="12"/>
                <Border Height="2" CornerRadius="1" Background="#FFB74D"
                        IsVisible="{Binding IsTemperatureChart}"/>
              </StackPanel>
            </Button>
            <Button Classes="tab" Command="{Binding ShowHumidityChartCommand}"
                    ToolTip.Tip="Влажность воздуха DHT">
              <StackPanel Orientation="Vertical" Spacing="3">
                <TextBlock Text="Влажность" Foreground="White" FontSize="12"/>
                <Border Height="2" CornerRadius="1" Background="#81D4FA"
                        IsVisible="{Binding IsHumidityChart}"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" Margin="24,0,16,0">

            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSoilChart}">
              <Border Width="12" Height="12" Background="#4FC3F7"
                      CornerRadius="6" VerticalAlignment="Center"/>
              <TextBlock Text="Датчик 1" Foreground="#7FB3D5"
                         FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSoilChart}">
              <Border Width="12" Height="12" Background="#4CAF50"
                      CornerRadius="6" VerticalAlignment="Center"/>
              <TextBlock Text="Датчик 2" Foreground="#7FB3D5"
                         FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsTemperatureChart}">
              <Border Width="12" Height="12" Background="#FFB74D"
                      CornerRadius="6" VerticalAlignment="Center"/>
              <TextBlock Text="Датчик 1" Foreground="#7FB3D5"
                         FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsTemperatureChart}">
              <Border Width="12" Height="12" Background="#F06292"
                      CornerRadius="6" VerticalAlignment="Center"/>
              <TextBlock Text="Датчик 2" Foreground="#7FB3D5"
                         FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsHumidityChart}">
              <Border Width="12" Height="12" Background="#81D4FA"
                      CornerRadius="6" VerticalAlignment="Center"/>
              <TextBlock Text="Датчик 1" Foreground="#7FB3D5"
                         FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsHumidityChart}">
              <Border Width="12" Height="12" Background="#AED581"
                      CornerRadius="6" VerticalAlignment="Center"/>
              <TextBlock Text="Датчик 2" Foreground="#7FB3D5"
                         FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
            <Button Classes="iconbtn" ToolTip.Tip="Обновить данные"
                    Command="{Binding RefreshChartCommand}">
              <Image Source="{SvgImage /Assets/refresh-cw.svg}" Width="20" Height="20"/>
            </Button>
            <Button Classes="iconbtn" ToolTip.Tip="Пауза / Продолжить"
                    Command="{Binding TogglePauseCommand}">
              <Grid>
                <Image Source="{SvgImage /Assets/circle-pause.svg}"
                       IsVisible="{Binding IsChartPaused}" Width="20" Height="20"/>
                <Image Source="{SvgImage /Assets/circle-play.svg}"
                       IsVisible="{Binding IsChartResumed}" Width="20" Height="20"/>
              </Grid>
            </Button>
            <Button Classes="iconbtn" ToolTip.Tip="Очистить график"
                    Command="{Binding ClearChartCommand}">
              <Image Source="{SvgImage /Assets/eraser.svg}" Width="20" Height="20"/>
            </Button>
          </StackPanel>
        </Grid>

        <avalonia:CartesianChart
          Grid.Row="1"
          Series="{Binding Series}"
          XAxes="{Binding XAxes}"
          YAxes="{Binding YAxes}"
          Margin="0,12,0,0"
          Height="220"
          TooltipPosition="Top"/>
      </Grid>
    </Border>

    <!-- FOOTER -->
    <Border Grid.Row="4" Background="#102840" CornerRadius="12" Padding="16">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Status}"
                   Foreground="#FFC107" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}"
                   Foreground="{Binding ConnectionColor}"
                   FontSize="13" Margin="0,0,16,0"/>
        <TextBlock Grid.Column="2" Text="{Binding LastUpdate}"
                   Foreground="#7FB3D5" FontSize="13"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>