<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GreenhouseApp.ViewModels.Pages"
             xmlns:vmc="using:GreenhouseApp.ViewModels.Components"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="vm:ListDeviceUserControlViewModel"
             x:Class="GreenhouseApp.Views.Pages.ListDeviceUserControlView">

    <UserControl.Styles>
        <Style Selector="Button.row-btn">
            <Setter Property="Background" Value="#16324F"/>
            <Setter Property="BorderBrush" Value="#2A4A6E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E0F2FE"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.row-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2563A8"/>
            <Setter Property="BorderBrush" Value="#4FC3F7"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.danger-btn">
            <Setter Property="Background" Value="#2A1820"/>
            <Setter Property="BorderBrush" Value="#662030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF8080"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.danger-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#A82535"/>
            <Setter Property="BorderBrush" Value="#FF5252"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.danger-confirm">
            <Setter Property="Background" Value="#A82535"/>
            <Setter Property="BorderBrush" Value="#FF5252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="24,24,24,40" Spacing="16">

                <TextBlock Text="Устройства"
                           Foreground="White" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Создание, редактирование и удаление теплиц на сервере"
                           Foreground="#7FB3D5" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <Border Classes="card">
                    <StackPanel Spacing="10" Orientation="Horizontal">
                        <Button Command="{Binding AddDeviceCommand}" Classes="cmd" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Svg Path="/Assets/plus.svg" Width="15" Height="15"/>
                                <TextBlock Text="Добавить устройство" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Classes="row-btn" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Svg Path="/Assets/refresh-cw.svg" Width="14" Height="14"/>
                                <TextBlock Text="Обновить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8080" FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vmc:DeviceListItemViewModel">
                            <Border Classes="card" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="#0A1929" CornerRadius="10"
                                            Width="46" Height="46" VerticalAlignment="Center">
                                        <Svg Path="{Binding IconPath}" Width="24" Height="24"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Name}" Foreground="#E0F2FE"
                                                   FontSize="15" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="#4FC3F7" FontSize="12"/>
                                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" Foreground="#8FA8BF" FontSize="12"/>
                                            <Button Command="{Binding CopyKeyCommand}"
                                                    ToolTip.Tip="Нажмите, чтобы скопировать api_key"
                                                    Classes="key-btn">
                                                <TextBlock Text="{Binding KeyDisplay}" FontFamily="Consolas"/>
                                            </Button>
                                            <TextBlock Text="{Binding LastSeenText, StringFormat='онлайн: {0}'}" Foreground="#8FA8BF" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Command="{Binding $parent[ItemsControl].DataContext.EditDeviceCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="row-btn">
                                            <TextBlock Text="Изменить"/>
                                        </Button>
                                        <Button Command="{Binding $parent[ItemsControl].DataContext.DeleteDeviceCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="danger-btn"
                                                IsVisible="{Binding !IsConfirmingDelete}">
                                            <TextBlock Text="Удалить"/>
                                        </Button>
                                        <Button Command="{Binding $parent[ItemsControl].DataContext.DeleteDeviceCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="danger-confirm"
                                                IsVisible="{Binding IsConfirmingDelete}">
                                            <TextBlock Text="Точно удалить?"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Foreground="#5B7F99" FontSize="12" TextWrapping="Wrap" LineHeight="17">
                    Подсказка: после создания устройства сервер вернёт уникальный api_key — впишите его в прошивку ESP32 (API_KEY и DEVICE_ID) перед загрузкой.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>