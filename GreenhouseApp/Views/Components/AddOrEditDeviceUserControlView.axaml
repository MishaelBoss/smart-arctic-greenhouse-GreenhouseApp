<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:GreenhouseApp.ViewModels.Components"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DataType="vm:AddOrEditDeviceUserControlViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Focusable="True"
             x:Class="GreenhouseApp.Views.Components.AddOrEditDeviceUserControlView">

    <UserControl.Styles>
        <StyleInclude Source="/Styles/ViewImageStyles.axaml"/>
        <StyleInclude Source="/Styles/SettingsStyles.axaml"/>

        <Style Selector="Button.type-btn">
            <Setter Property="Background" Value="#16324F"/>
            <Setter Property="BorderBrush" Value="#2A4A6E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#8FA8BF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.type-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1B3A5C"/>
            <Setter Property="BorderBrush" Value="#3A5C86"/>
        </Style>
        <Style Selector="Button.type-btn.selected">
            <Setter Property="Background" Value="#1E4670"/>
            <Setter Property="BorderBrush" Value="#4FC3F7"/>
            <Setter Property="Foreground" Value="#E0F2FE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Button Command="{Binding CancelCommand}" Classes="backdrop-btn"/>

        <Border Background="#102840" BorderBrush="#2563A8" BorderThickness="1.5"
                CornerRadius="14" Margin="24" Padding="0"
                Width="480"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 10 30 0 #A0000000">
            <Grid RowDefinitions="Auto, *, Auto">
                <Border Grid.Row="0" Background="#0D2136" Padding="18,14"
                        CornerRadius="14,14,0,0" BorderBrush="#1A3A5C" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Title}"
                                   Foreground="#E0F2FE" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CancelCommand}" Classes="close-btn">
                            <Svg Path="/Assets/x.svg" Width="13" Height="13"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Spacing="12" Margin="20" IsVisible="{Binding !IsCreated}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Название" Classes="FieldLabel"/>
                        <TextBox Text="{Binding Name}" Classes="TB1"
                                 PlaceholderText="Теплица №1, уличная теплица..."/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Тип подключения" Classes="FieldLabel"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="type-btn" Command="{Binding SelectWifiCommand}"
                                    Classes.selected="{Binding IsWifi}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Svg Path="/Assets/wifi.svg" Width="16" Height="16"/>
                                    <TextBlock Text="Wi-Fi" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="type-btn" Command="{Binding SelectUsbCommand}"
                                    Classes.selected="{Binding IsUsb}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Svg Path="/Assets/usb.svg" Width="16" Height="16"/>
                                    <TextBlock Text="USB" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Foreground="#5B7F99" FontSize="11" TextWrapping="Wrap" LineHeight="15">
                            Wi-Fi — ESP32 шлёт данные на сервер по сети. USB — ESP32 подключён кабелем к этому ПК.
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8080" FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                </StackPanel>

                <!-- Экран успеха после создания -->
                <StackPanel Grid.Row="1" Spacing="10" Margin="20" IsVisible="{Binding IsCreated}">
                    <Border Background="#0F2540" CornerRadius="8" Padding="10"
                            BorderBrush="#2A4A6E" BorderThickness="1">
                        <TextBlock Text="Устройство создано. Скопируйте api_key в прошивку (API_KEY и DEVICE_ID):"
                                   Foreground="#B8CEE0" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                    <Button Command="{Binding CopyCreatedKeyCommand}"
                        ToolTip.Tip="Нажмите, чтобы скопировать api_key"
                        Classes="key-btn"
                        HorizontalAlignment="Stretch"
                        MinHeight="34">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding CreatedApiKey}"
                                       FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Скопировано" Foreground="#4FC3F7" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsKeyCopied}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Foreground="#5B7F99" FontSize="11" TextWrapping="Wrap" LineHeight="15">
                        Ключ хранится на сервере и больше не отобразится в этом окне.
                    </TextBlock>
                </StackPanel>

                <Border Grid.Row="2" Background="#0D2136" Padding="16,12"
                        CornerRadius="0,0,14,14" BorderBrush="#1A3A5C" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Enter — сохранить, Esc — отмена"
                                   Foreground="#5B7F99" FontSize="11" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsCreated}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Content="Отмена" Command="{Binding CancelCommand}"
                                    Classes="Cancel" Width="90" Height="34"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <Button Content="Сохранить" Command="{Binding SaveCommand}"
                                    Classes="Ok" Width="110" Height="34"
                                    IsEnabled="{Binding !IsBusy}"
                                    IsVisible="{Binding !IsCreated}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <Button Content="Готово" Command="{Binding CancelCommand}"
                                    Classes="Ok" Width="110" Height="34"
                                    IsVisible="{Binding IsCreated}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>