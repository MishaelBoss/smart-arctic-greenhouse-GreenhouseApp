<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:GreenhouseApp.ViewModels.Components"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DataType="vm:ViewImageUserControlViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Focusable="True"
             x:Class="GreenhouseApp.Views.Components.ViewImageUserControlView">

    <UserControl.Styles>
        <StyleInclude Source="/Styles/ViewImageStyles.axaml"/>
    </UserControl.Styles>

    <Grid>
        <Button Command="{Binding CloseLightboxCommand}" Classes="backdrop-btn"/>
        <Border Background="#102840" BorderBrush="#2563A8" BorderThickness="1.5"
                CornerRadius="14" Margin="24"
                MaxWidth="1150" MaxHeight="750"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 10 30 0 #A0000000">
            <Grid RowDefinitions="Auto, *, Auto">
                <Border Grid.Row="0" Background="#0D2136" Padding="16,12"
                        CornerRadius="14,14,0,0" BorderBrush="#1A3A5C" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="{Binding LightboxTitle}"
                                   Foreground="#E0F2FE" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding ZoomOutCommand}" Classes="tool-btn" ToolTip.Tip="Уменьшить (или колёсико мыши вниз)">
                                <Svg Path="/Assets/minus.svg" Width="15" Height="15" Css="* { stroke-width: 3; }"/>
                            </Button>

                            <Border Background="#0A1929" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ZoomPercentText}" Foreground="#4FC3F7"
                                           FontSize="12" FontWeight="SemiBold" Width="45" TextAlignment="Center"/>
                            </Border>

                            <Button Command="{Binding ZoomInCommand}" Classes="tool-btn" ToolTip.Tip="Увеличить (или колёсико мыши вверх)">
                                <Svg Path="/Assets/plus.svg" Width="15" Height="15" Css="* { stroke-width: 3; }"/>
                            </Button>

                            <Button Command="{Binding ResetZoomCommand}" Classes="tool-btn" ToolTip.Tip="Масштаб 100%">
                                <TextBlock Text="100%" FontSize="11" FontWeight="SemiBold"/>
                            </Button>

                            <Button Command="{Binding FitToWindowCommand}" Classes="tool-btn" ToolTip.Tip="Подогнать под размер окна">
                                <TextBlock Text="По окну" FontSize="11" FontWeight="SemiBold"/>
                            </Button>

                            <Border Width="1" Height="20" Background="#1A3A5C" Margin="4,0"/>

                            <Button Command="{Binding CloseLightboxCommand}" Classes="close-btn" ToolTip.Tip="Закрыть (Esc)">
                                <Svg Path="/Assets/x.svg" Width="13" Height="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#071322"
                              Padding="16">
                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                        </LayoutTransformControl.LayoutTransform>
                        <Image Source="{Binding LightboxImage}" Stretch="None"/>
                    </LayoutTransformControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#0D2136" Padding="14,8"
                        CornerRadius="0,0,14,14" BorderBrush="#1A3A5C" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Используйте колёсико мыши или кнопки [+]/[−] для приближения схемы и текста"
                                   Foreground="#5B7F99" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Esc или клик вне окна — закрыть"
                                   Foreground="#7FB3D5" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>