<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GreenhouseApp.ViewModels"
             xmlns:uc="using:GreenhouseApp.Views.Components"
             xmlns:controls="clr-namespace:GreenhouseApp.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GreenhouseApp.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    
            
    <Grid ColumnDefinitions="*, Auto">
        <Grid Grid.Column="0">
            <controls:FadeContentControl Content="{Binding CurrentPage}" ZIndex="0"/>
            <controls:FadeContentControl Content="{Binding TopOverlayContent}" ZIndex="999"/>
            <ScrollViewer ZIndex="999" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                          MaxHeight="300" Margin="12">
            </ScrollViewer>
        </Grid>
        <uc:LeftBoardUserControl Grid.Column="1" DataContext="{Binding LeftBoardUserControlViewModel}"/>
    </Grid>
</UserControl>
