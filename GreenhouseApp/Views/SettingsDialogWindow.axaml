<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GreenhouseApp.ViewModels"
        xmlns:settings="clr-namespace:GreenhouseApp.Views.Settings"
        xmlns:settingsVm="clr-namespace:GreenhouseApp.ViewModels.Settings"
        x:DataType="vm:SettingsDialogWindowViewModel"
        mc:Ignorable="d" 
        d:DesignWidth="1000" d:DesignHeight="600"
        Width="1000" Height="620"
        MinWidth="800" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#0A1929"
        x:Class="GreenhouseApp.Views.SettingsDialogWindow"
        Title="">
    <Window.Styles>
        <StyleInclude Source="/Styles/SettingsStyles.axaml"/>
    </Window.Styles>
    
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type settingsVm:LoggingViewModel}">
            <settings:LoggingView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto, *, Auto">
        <Border Grid.Row="0" 
                Height="38" 
                Background="#0A1929" 
                Padding="16,0,24,0"
                BorderBrush="#1A3A5C" 
                BorderThickness="0,0,0,1"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="Auto, *">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Image Source="/Assets/logo/logo.ico" Width="18" Height="18" IsVisible="{OnPlatform True, macOS=False}"/>
                </StackPanel>
        
                <TextBlock Grid.Column="1"
                           Margin="5,0,0,0"
                           Text="settings"
                           FontWeight="SemiBold"
                           Foreground="#E0F2FE"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="250, *">
            <Grid Grid.Column="0" RowDefinitions="Auto, *" Background="#0A1929" Margin="0,0,0,0">
                <TextBox Grid.Row="0" 
                         Margin="10,4" 
                         PlaceholderText="Search" 
                         Height="32" 
                         Classes="Search"/>
                
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Pages}" 
                         SelectedItem="{Binding SelectedPage}" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Margin="0,12,0,0">
                    
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="#8FA8BF"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="Margin" Value="8,2"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#16324F"/>
                            <Setter Property="Foreground" Value="#E0F2FE"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1E4670"/>
                            <Setter Property="Foreground" Value="#4FC3F7"/>
                        </Style>
                    </ListBox.Styles>
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="1" 
                    Background="#132A47" 
                    CornerRadius="0, 0,12, 12" 
                    Margin="0,0,16,16">
                
                <Grid RowDefinitions="Auto, *" Margin="24">
                    <TextBlock Grid.Row="0" 
                               Text="{Binding SelectedPage.Title}" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="White" 
                               Margin="0,0,0,16"/>
                    
                    <ContentControl Grid.Row="1" 
                                    Content="{Binding SelectedPage.ViewModel}"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0A1929" Padding="16,12,24,16"
                BorderBrush="#1A3A5C" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0"
                           Text="Изменения сохраняются после нажатия «Применить»"
                           Foreground="#5B7F99" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="ОК"
                            Command="{Binding OkCommand}" CommandParameter="{Binding $parent[Window]}"
                            IsDefault="True"
                            Width="85" Height="34"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            Classes="Ok"/>
                    <Button Content="Отмена"
                            Command="{Binding CancelCommand}" CommandParameter="{Binding $parent[Window]}"
                            IsCancel="True"
                            Width="85" Height="34"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            Classes="Cancel"/>
                    <Button Classes="Apply"
                            Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding HasChanges}"
                            Width="130" Height="34"
                            Padding="0">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{SvgImage /Assets/save.svg}" Width="14" Height="14"/>
                            <TextBlock Text="Применить" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
