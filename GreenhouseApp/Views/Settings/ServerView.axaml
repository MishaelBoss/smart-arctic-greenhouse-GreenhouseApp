<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GreenhouseApp.ViewModels.Settings"
             x:DataType="vm:ServerViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GreenhouseApp.Views.Settings.ServerView">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/SettingsStyles.axaml"/>
    </UserControl.Styles>

    <StackPanel Spacing="20">
        <TextBlock Text="Адрес backend-сервера, на который стучится это приложение. На телефоне укажите IP компьютера в локальной сети (не localhost)."
                   Foreground="#8FA8BF"
                   FontSize="13"
                   TextWrapping="Wrap"/>

        <Border BorderBrush="#1A3A5C" BorderThickness="1" CornerRadius="8" Padding="16" Background="#102840">
            <StackPanel Spacing="6">
                <TextBlock Text="Адрес сервера" Classes="FieldLabel"/>
                <TextBox Text="{Binding ServerUrl}" Classes="Search"
                         PlaceholderText="http://192.168.1.10:8000"/>
                <TextBlock Text="Например: http://192.168.1.10:8000 — IP ПК, где запущен backend. Порт по умолчанию 8000."
                           Foreground="#5B7F99" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>